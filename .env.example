# Example environment variables for local development
# Copy this file to .env and adjust values as needed

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=operational_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Kafka (override docker-compose defaults if needed)
KAFKA_CLUSTER_ID=oh-sxaDRTcyAr6pFRbXyzA
KAFKA_NODE_ID=1
KAFKA_NODE_ROLE=combined
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_LISTENERS=INTERNAL://0.0.0.0:29092,EXTERNAL://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093
KAFKA_ADVERTISED_LISTENERS=INTERNAL://kafka:29092,EXTERNAL://localhost:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL

# Debezium Connect (internal bootstrap server)
CONNECT_BOOTSTRAP_SERVERS=kafka:29092

# MinIO / S3 (S3-compatible)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
MINIO_DOMAIN=minio
# Optional S3 client vars that applications may use
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1

# Optional application-level overrides
#KAFKA_TOPIC_PREFIX=postgres-db
#SOME_APP_FEATURE_FLAG=false
